# MediaOS environment configuration template
# Copy to .env and adjust values for your deployment.
# Every variable below maps 1:1 to a Settings field in app/config.py,
# unless noted as a Docker Compose infrastructure variable.
# Lines marked with '# sensitive' hold secrets — do not commit real values.

# ─────────────────────────────────────────────────────────────────────────────
# Docker Compose infrastructure variables (used by docker-compose.yml, not app/)
# ─────────────────────────────────────────────────────────────────────────────
# Container user/group IDs (match your host media file ownership)
PUID=1000
PGID=1000
# Timezone
TZ=UTC
# Postgres database credentials — REQUIRED, no defaults for password.
# Run: bash scripts/generate_secrets.sh  (auto-generates secure values)
POSTGRES_USER=mediaos
POSTGRES_PASSWORD=  # sensitive — REQUIRED, run scripts/generate_secrets.sh
POSTGRES_DB=mediaos
# Image tag for the MediaOS app container
MEDIAOS_IMAGE_TAG=next
# Host port mappings
MEDIAOS_HOST_PORT=8787
JELLYFIN_HOST_PORT=8096
QBIT_HOST_PORT=8080
QBIT_TORRENT_PORT=6881
# Jellyfin published server URL (for reverse proxy / external access)
JELLYFIN_PUBLISHED_URL=http://localhost:8096
# Resource limits (per container)
MEDIAOS_MEMORY_LIMIT=2g
MEDIAOS_CPUS=2.0
JELLYFIN_MEMORY_LIMIT=2g
JELLYFIN_CPUS=2.0
POSTGRES_MEMORY_LIMIT=512m
POSTGRES_CPUS=1.0
REDIS_MEMORY_LIMIT=384m
# VPN type for Gluetun (wireguard or openvpn)
VPN_TYPE=wireguard

# Docker host paths — these are HOST directories that get mounted into the
# MediaOS, Jellyfin, and qBittorrent containers. The in-container target paths
# are fixed (e.g. /movies, /tv) and match the *_LIBRARY_PATH app settings below,
# which enables hardlinks between qBittorrent downloads and the libraries.
# Change the host side (left of the mount) to point at your storage; keep the
# container side fixed unless you also update app/config.py *_LIBRARY_PATH fields.
MOVIES_PATH=./data/movies
TV_PATH=./data/tv
MUSIC_PATH=./data/music
BOOKS_PATH=./data/books
AUDIOBOOKS_PATH=./data/audiobooks
COMICS_PATH=./data/comics
MANGA_PATH=./data/manga
PODCASTS_PATH=./data/podcasts
YOUTUBE_PATH=./data/youtube
GAMES_PATH=./data/games
ADULT_PATH=./data/adult
DOWNLOADS_PATH=./data/downloads
# MediaOS persistent config (database migrations, secrets cache, logs)
MEDIAOS_DATA_PATH=./data/mediaos
# Tdarr working directories (only used with profile: tdarr or full)
TDARR_TEMP_PATH=./data/tdarr/temp
TDARR_MEDIA_PATH=./data/media
# Postgres/qBittorrent persistent host paths for backup tooling (optional)
P_MOVIES_HOST_PATH=./data/movies
P_TV_HOST_PATH=./data/tv
D_MOVIES_HOST_PATH=./data/movies
D_TV_HOST_PATH=./data/tv

# ─────────────────────────────────────────────────────────────────────────────
# Application settings (map to Settings fields in app/config.py)
# ─────────────────────────────────────────────────────────────────────────────

