# MediaOS — environment template
#
#   cp .env.example .env
#   bash scripts/generate_secrets.sh   # fills POSTGRES_PASSWORD + AUTH_API_KEY
#
# Then edit the values below marked "# sensitive" and the library paths.
# Container-side paths (the right half of each library mount, e.g. /movies)
# are fixed across services on purpose — do not change those; only the
# host-side *_PATH values here need to point at your actual storage.

# ── Timezone ─────────────────────────────────────────────────────────────
TZ=UTC

# ── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_USER=mediaos
POSTGRES_PASSWORD=  # sensitive - required, no default. Run scripts/generate_secrets.sh to fill this in.
POSTGRES_DB=mediaos
POSTGRES_CPUS=1.0
POSTGRES_MEMORY_LIMIT=512m

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_MEMORY_LIMIT=384m

# ── Authentication ───────────────────────────────────────────────────────
# generate_secrets.sh manages AUTH_API_KEY and AUTH_REQUIRE for you.
AUTH_API_KEY=  # sensitive - generated by scripts/generate_secrets.sh
AUTH_REQUIRE=true
AUTH_SEED_ADMIN_USERNAME=admin
AUTH_SEED_ADMIN_PASSWORD=  # sensitive - set for production; leave blank in dev to use the bootstrap key file instead

# ── Metadata providers ───────────────────────────────────────────────────
# From https://www.themoviedb.org/settings/api (TMDb) and https://thetvdb.com/api-information (optional)
TMDB_API_KEY=  # sensitive
TVDB_API_KEY=  # sensitive

# ── qBittorrent (reached through Gluetun's network namespace) ───────────
QBIT_URL=http://gluetun:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=  # sensitive
QBIT_HOST_PORT=8080
# WebUI is loopback-only by default (weak default auth, no reason to be
# LAN-reachable out of the box). Set to 0.0.0.0 for LAN access.
QBIT_HOST_BIND=127.0.0.1
QBIT_TORRENT_PORT=6881
QBIT_CPUS=2.0
QBIT_MEMORY_LIMIT=1g

# ── Jellyfin ─────────────────────────────────────────────────────────────
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=  # sensitive - generate from Jellyfin Dashboard > API Keys after first login
JELLYFIN_HOST_PORT=8096
JELLYFIN_PUBLISHED_URL=http://localhost:8096
JELLYFIN_CPUS=2.0
JELLYFIN_MEMORY_LIMIT=2g

# ── VPN (Gluetun) ────────────────────────────────────────────────────────
# VPN is on by default; qBittorrent has no network access without it
# (kill-switch). See docs/VPN-SETUP.md.
VPN_ENABLED=true
VPN_KILL_SWITCH=true
# VPN_PROVIDER / VPN_GLUETUN_URL are fixed by MediaOS's architecture (it
# always health-checks the bundled gluetun service) — listed here for
# reference, not because compose reads them from .env.
VPN_PROVIDER=gluetun
VPN_GLUETUN_URL=http://gluetun:8000
VPN_TYPE=wireguard
VPN_SERVICE_PROVIDER=custom
VPN_SERVER_COUNTRIES=Netherlands
VPN_SERVER_CITIES=
VPN_PORT_FORWARDING=false

# WireGuard (used when VPN_TYPE=wireguard)
VPN_WIREGUARD_PRIVATE_KEY=  # sensitive
VPN_WIREGUARD_ADDRESSES=
VPN_WIREGUARD_PUBLIC_KEY=
VPN_WIREGUARD_PRESHARED_KEY=  # sensitive
VPN_WIREGUARD_ENDPOINT_IP=
VPN_WIREGUARD_ENDPOINT_PORT=51820

# OpenVPN (used when VPN_TYPE=openvpn)
VPN_USERNAME=
VPN_PASSWORD=  # sensitive

# ── Library host paths ───────────────────────────────────────────────────
# Point these at your actual storage. Container-side paths stay fixed
# (see docker-compose.yml) so hardlinks work across MediaOS/Jellyfin/qBittorrent.
MOVIES_PATH=./data/movies
TV_PATH=./data/tv
MUSIC_PATH=./data/music
BOOKS_PATH=./data/books
AUDIOBOOKS_PATH=./data/audiobooks
PODCASTS_PATH=./data/podcasts
COMICS_PATH=./data/comics
MANGA_PATH=./data/manga
YOUTUBE_PATH=./data/youtube
DOWNLOADS_PATH=./data/downloads
GAMES_PATH=./data/games
ADULT_PATH=./data/adult

# Compatibility mounts for existing MediaOS/Jellyfin deployments using the
# older "P:" / "D:" drive-letter layout. Safe to leave at these defaults
# if you don't have that layout.
P_MOVIES_HOST_PATH=./data/movies
P_TV_HOST_PATH=./data/tv
D_MOVIES_HOST_PATH=./data/movies-d
D_TV_HOST_PATH=./data/tv-d

# ── MediaOS app data/config ──────────────────────────────────────────────
MEDIAOS_DATA_PATH=./data/mediaos
MEDIAOS_CONFIG=./config/mediaos
MEDIAOS_HOST_PORT=8787
MEDIAOS_IMAGE_TAG=1.01beta
MEDIAOS_CPUS=2.0
MEDIAOS_MEMORY_LIMIT=2g
# System Monitor page SMART panel — comma-separated device paths, e.g.
# /dev/sda,/dev/sdb. Requires uncommenting the matching `devices:` block
# under the mediaos service in docker-compose.yml. Leave empty to hide SMART.
SMART_DEVICES=

# ── Host user / permissions (linuxserver.io images: Jellyfin, qBittorrent) ─
PUID=1000
PGID=1000

# ── Optional: Tdarr transcoding farm (--profile tdarr) ───────────────────
TDARR_ENABLED=false
TDARR_URL=http://tdarr:8265
TDARR_HOST_PORT=8265
# Internal tooling, loopback-only by default. Set to 0.0.0.0 for LAN access.
TDARR_HOST_BIND=127.0.0.1
TDARR_TEMP_PATH=./data/tdarr-tmp

# ── Optional: Live TV / EPG sidecar (--profile full) ─────────────────────
LIVETV_SEED_IPTV_ORG=true
LIVETV_AUTO_GRAB=true
LIVETV_EPG_SIDECAR_URL=http://iptv-org-epg:3000/guide.xml
EPG_SITE=tvtv.us
EPG_DAYS=2
EPG_CRON_HOURS=6
EPG_GIT_REF=0e03581
EPG_HOST_PORT=3099
# Internal tooling, loopback-only by default. Set to 0.0.0.0 for LAN access.
EPG_HOST_BIND=127.0.0.1
EPG_CPUS=1.0
EPG_MEMORY_LIMIT=512m

# ── Optional: FlareSolverr (Cloudflare bypass for indexers) ──────────────
FLARESOLVERR_URL=http://flaresolverr:8191
FLARESOLVERR_HOST_PORT=8191
# Internal tooling, loopback-only by default. Set to 0.0.0.0 for LAN access.
FLARESOLVERR_HOST_BIND=127.0.0.1
FLARESOLVERR_LOG_LEVEL=info
FLARESOLVERR_MEMORY_LIMIT=512m

# ── Optional: Ollama (local LLM for AI features, --profile full) ─────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
