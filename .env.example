# --- Database ---
DATABASE_URL=postgresql://mediaos:mediaos@mediaos-db:5432/mediaos

# --- TMDb (movie metadata) --- https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- TVDb (TV metadata) --- https://thetvdb.com/api-information
TVDB_API_KEY=
TVDB_PIN=

# --- Prowlarr (indexer aggregation) ---
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=

# --- qBittorrent (download client) ---
QBIT_URL=http://qbittorrent:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=adminadmin

# --- Library / paths (inside the container) ---
# Must match qBittorrent's view of the downloads folder
MOVIES_LIBRARY_PATH=/movies
TV_LIBRARY_PATH=/tv
DOWNLOADS_PATH=/downloads
MUSIC_LIBRARY_PATH=/music
BOOKS_LIBRARY_PATH=/books
AUDIOBOOKS_LIBRARY_PATH=/audiobooks
PODCASTS_LIBRARY_PATH=/podcasts
PODCAST_CHECK_INTERVAL_MINUTES=30
PODCAST_AUTO_DOWNLOAD_DEFAULT=true
PODCAST_BACKLOG_DOWNLOAD=false

# --- Behavior ---
SEARCH_INTERVAL_MINUTES=15
MIN_SEEDERS=3
DOWNLOAD_TIMEOUT_HOURS=24
ALLOW_USENET=false
MAX_DOWNLOAD_FAILURES=2

# --- Upgrades ---
UPGRADE_ENABLED=true
UPGRADE_MIN_SCORE_GAP=50
UPGRADE_SEARCH_INTERVAL_HOURS=24

# --- Subtitles (OpenSubtitles.com) ---
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
SUBTITLE_LANGUAGES=en

# --- Notifications / hooks ---
APPRISE_URL=
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

# --- Auth (leave empty to disable) ---
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_API_KEY=

# --- FlareSolverr (optional but recommended for CF-heavy public indexers) ---
# Builtin indexers already try curl_cffi impersonation first.
# When a site still challenges, MediaOs falls through to FlareSolverr if set.
# docker compose -f docker-compose.standalone.yml --profile cf up -d
FLARESOLVERR_URL=http://flaresolverr:8191

# --- Seed first DB admin (only if users table empty) ---
AUTH_SEED_ADMIN_USERNAME=
AUTH_SEED_ADMIN_PASSWORD=

# --- VPN / Gluetun ---
VPN_ENABLED=false
VPN_PROVIDER=gluetun
VPN_GLUETUN_URL=http://gluetun:8000
VPN_EXPECTED_COUNTRY=
VPN_PUBLIC_IP_URL=https://ifconfig.io/ip
VPN_KILL_SWITCH=true

# --- Movies (Radarr path) ---
# download = qBittorrent | strm = write .strm with release URL (no local download)
MOVIE_DOWNLOAD_MODE=download
MOVIE_WRITE_STRM_SIDECAR=false

# Subtitles (Bazarr path)
# Supported: opensubtitles (primary), subdl.
# Best-effort only (need FlareSolverr): addic7ed, subscene, yify — not recommended for production.
SUBTITLE_PROVIDERS=opensubtitles
SUBTITLE_HEARING_IMPAIRED=include
# TV continuous
TV_PREFER_SEASON_PACKS=true
TV_RSS_LOOKBACK_DAYS=14

# --- LunaSea / Jellyseerr (*arr API shim) ---
# Jellyseerr: add both Radarr and Sonarr servers → this mediaos URL
# Point LunaSea Sonarr/Radarr host at mediaos base URL; use this key as API key
ARR_API_KEY=

# --- Cross-Seed ---
CROSS_SEED_URL=http://cross-seed:2468
CROSS_SEED_API_KEY=

# --- Unpack (Unpackerr-style) ---
UNPACK_ENABLED=true
UNPACK_DELETE_ARCHIVE=false

# --- jdupes ---
JDUPES_ENABLED=true
JDUPES_PATH=jdupes
JDUPES_HARDLINK=false

# Usenet
SABNZBD_URL=
SABNZBD_API_KEY=
SABNZBD_CATEGORY=mediaos

# Real-Debrid
REAL_DEBRID_TOKEN=

# Trakt
TRAKT_CLIENT_ID=
TRAKT_ACCESS_TOKEN=

# Built-in CF bypass
CF_BYPASS_ENABLED=true
CF_IMPERSONATE=chrome124

# NNTP seekable usenet
NNTP_HOST=
NNTP_PORT=563
NNTP_USER=
NNTP_PASS=
NNTP_SSL=true

# Stalker
STALKER_PORTAL_URL=
STALKER_MAC=

# Usenet — NZBGet (optional; used when usenet_client prefers it or SABnzbd is unset)
NZBGET_URL=
NZBGET_USERNAME=nzbget
NZBGET_PASSWORD=tegbzn6789
NZBGET_CATEGORY=mediaos
USENET_CLIENT=auto

# Extra debrid providers
TORBOX_API_KEY=
ALLDEBRID_API_KEY=
PREMIUMIZE_API_KEY=

# TRaSH-style naming
MOVIE_NAMING_FOLDER={title} ({year}) {tmdb-{tmdb_id}}
EPISODE_NAMING={series} - S{season:00}E{episode:00} - {title}

# Upgrade policy (MediaOs-style)
UPGRADE_PREVENT_RESOLUTION_DOWNGRADE=true
FAILED_DOWNLOAD_COOLDOWN_HOURS=1

# Emby (optional; Jellyfin also supported)
EMBY_URL=
EMBY_API_KEY=

COMICS_LIBRARY_PATH=/comics
MANGA_LIBRARY_PATH=/manga
COMICVINE_API_KEY=
YOUTUBE_LIBRARY_PATH=/youtube
YOUTUBE_CHECK_INTERVAL_MINUTES=60
YOUTUBE_AUTO_DOWNLOAD_DEFAULT=true
YOUTUBE_YTDLP_PATH=yt-dlp
YOUTUBE_FORMAT=best[height<=1080]
YOUTUBE_BACKLOG_DOWNLOAD=false
YOUTUBE_COOKIES_PATH=
YOUTUBE_COOKIES_FROM_BROWSER=
YOUTUBE_SPONSORBLOCK_REMOVE=sponsor,selfpromo,interaction,intro,outro,preview,music_offtopic
YOUTUBE_SPONSORBLOCK_MARK=
YOUTUBE_EMBED_PLAYER=true
PODCAST_CHAPTERS_ENABLED=true

# --- Cardigann YAML ---
CARDIGANN_ENABLED=true
CARDIGANN_DEFINITIONS_PATH=./definitions
CARDIGANN_AUTO_SYNC=true
CARDIGANN_AUTO_SYNC_ON_STARTUP=true
# CARDIGANN_SYNC_MAX_FILES=0  # 0 = all Jackett YAML defs

# Seekable usenet stream cache
NNTP_CACHE_MB=64
NNTP_SESSION_TTL=3600
NNTP_PREFETCH_SEGMENTS=2

# Converter (Tdarr-style) — watch folders + hardware
CONVERTER_WATCH_FOLDERS=
CONVERTER_WATCH_PRESET_ID=
CONVERTER_WATCH_INTERVAL_MINUTES=15
CONVERTER_WATCH_LIMIT=50
CONVERTER_HWACCEL_DEFAULT=none

CONVERTER_MAX_WORKERS=2
CONVERTER_SCHEDULE_START_HOUR=
CONVERTER_SCHEDULE_END_HOUR=

# --- Queue cleaner (Cleanuparr-inspired) ---
CLEANUP_ENABLED=true
CLEANUP_MAX_STRIKES=3
CLEANUP_STALL_MINUTES=30
CLEANUP_MIN_SPEED_KB=20
CLEANUP_AUTO_SEARCH=true
CLEANUP_ORPHANS=true
CLEANUP_ORPHANS_DELETE=false
CLEANUP_INTERVAL_MINUTES=5
CLEANUP_SEED_ENABLED=true
CLEANUP_SEED_RATIO=2.0
CLEANUP_SEED_MINUTES=10080
CLEANUP_SEED_REQUIRE_BOTH=false
CLEANUP_SKIP_PRIVATE=true

# --- Extra torrent clients ---
TORRENT_CLIENT=qbittorrent
TRANSMISSION_URL=
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=
DELUGE_URL=
DELUGE_PASSWORD=
RTORRENT_URL=
ARIA2_URL=
ARIA2_SECRET=

# --- Jackett (indexer list sync) ---
JACKETT_URL=http://jackett:9117
JACKETT_API_KEY=
JACKETT_SYNC_ON_STARTUP=true

# TRaSH-style guide JSON (optional — uses builtin snapshot if empty)
TRASH_GUIDE_URL=
TRASH_GUIDE_PATH=
COMIC_PULL_SYNC_HOURS=12
TRASH_GUIDE_SYNC_HOURS=168
LIVETV_EPG_SYNC_HOURS=6
# Live TV: seed iptv-org US + Entertainment when DB has no sources (auto-updating URLs)
LIVETV_SEED_IPTV_ORG=true
LIVETV_IPTV_ORG_SYNC_HOURS=24
