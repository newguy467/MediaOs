# MediaOS environment example — copy to .env and set secrets before production.
# Never commit real secrets. Values below are placeholders for compose validation.

# --- Compose infra ---
PUID=1000
PGID=1000
TZ=UTC
MEDIAOS_HOST_PORT=8787
JELLYFIN_HOST_PORT=8096
QBIT_HOST_PORT=8080
MEDIAOS_IMAGE_TAG=1.01beta

# --- Database / redis ---
POSTGRES_USER=mediaos
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=mediaos
DATABASE_URL=postgresql://mediaos:change-me-strong@mediaos-db:5432/mediaos
REDIS_URL=redis://redis:6379/0

# --- Auth ---
AUTH_REQUIRE=true
# AUTH_API_KEY=
# ARR_API_KEY=

# --- qBittorrent (reachable via gluetun network namespace in full compose) ---
QBIT_URL=http://gluetun:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=

# --- Jellyfin ---
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

# --- Host library paths (mounted as /movies, /tv, … inside containers) ---
MOVIES_PATH=./data/movies
TV_PATH=./data/tv
MUSIC_PATH=./data/music
BOOKS_PATH=./data/books
AUDIOBOOKS_PATH=./data/audiobooks
COMICS_PATH=./data/comics
MANGA_PATH=./data/manga
YOUTUBE_PATH=./data/youtube
PODCASTS_PATH=./data/podcasts
GAMES_PATH=./data/games
ADULT_PATH=./data/adult
DOWNLOADS_PATH=./data/downloads
MEDIAOS_DATA_PATH=./data/mediaos
MEDIAOS_CONFIG=./config/mediaos

# --- VPN / gluetun (configure before enabling VPN routing) ---
VPN_ENABLED=false
VPN_PROVIDER=
VPN_KILL_SWITCH=true
VPN_GLUETUN_URL=http://gluetun:8000
VPN_SERVICE_PROVIDER=
VPN_WIREGUARD_PRIVATE_KEY=
VPN_WIREGUARD_ADDRESSES=
VPN_TYPE=openvpn
OPENVPN_USER=
OPENVPN_PASSWORD=
